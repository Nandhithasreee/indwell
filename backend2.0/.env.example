# Django
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database -- SQLite is used automatically unless DB_ENGINE=postgres.
# You said the real database design comes later, so this defaults to
# SQLite (zero setup) until you're ready to flip this.
DB_ENGINE=sqlite
DB_NAME=indwell
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS -- the React dev server origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis -- generation runs synchronously (no Redis required) by
# default. Set CELERY_TASK_ALWAYS_EAGER=False and run a worker once Redis
# is available if you want true background jobs (see README).
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# ---------------------------------------------------------------------
# LLM providers -- configure at least ONE. Tried in this priority order,
# automatically falling back to the next if one fails (including when a
# provider's free daily token/rate limit is hit -- see README).
# ---------------------------------------------------------------------
LLM_PROVIDER_PRIORITY=gemini,groq,openai,claude,ollama

# Groq (https://console.groq.com) -- hosts open models behind an OpenAI-compatible API
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

GEMINI_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Local models via Ollama (https://ollama.com) -- no API key needed,
# just a running `ollama serve` and a pulled model. Never runs out of
# "free daily tokens" since it's your own machine -- a good last resort
# at the end of the fallback chain.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# ---------------------------------------------------------------------
# Image providers -- entirely optional. The app works with zero image
# providers configured; IMAGE_GENERATION_ENABLED must also be True.
# ---------------------------------------------------------------------
IMAGE_GENERATION_ENABLED=False
IMAGE_PROVIDER_PRIORITY=flux,openai,stability,replicate,fal

REPLICATE_API_KEY=
# REPLICATE_API_KEY above powers both the "replicate" and "flux" providers.
STABILITY_API_KEY=
FAL_API_KEY=
# OPENAI_API_KEY above is reused for DALL-E image generation too.

# Business rules
DAILY_GENERATION_LIMIT=10
